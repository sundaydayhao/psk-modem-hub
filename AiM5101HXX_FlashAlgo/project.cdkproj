<?xml version="1.0" encoding="UTF-8"?>
<Project Name="AiM5101HXX_FlashAlgo" Version="1" Language="C" Type="Flash">
  <Description>Experimental AiM5101HXX embedded flash algorithm.</Description>
  <Dependencies Name="BuildSet"/>
  <VirtualDirectory Name="arch">
    <File Name="crt0.S"/>
    <File Name="encoding.h"/>
    <File Name="chip_name.c"/>
  </VirtualDirectory>
  <VirtualDirectory Name="script">
    <File Name="ckcpu.ld"/>
    <File Name="gdb.init"/>
  </VirtualDirectory>
  <VirtualDirectory Name="src">
    <File Name="main.c"/>
    <File Name="driver.c"/>
    <File Name="FlashDev.c"/>
  </VirtualDirectory>
  <BuildConfigs>
    <BuildConfig Name="BuildSet">
      <Target>
        <CPU>e906</CPU>
        <Endian>little</Endian>
        <UseMiniLib>yes</UseMiniLib>
        <UseHardFloat>no</UseHardFloat>
        <UseEnhancedLRW>no</UseEnhancedLRW>
      </Target>
      <Output>
        <OutputName>$(ProjectName)</OutputName>
        <Type>Executable</Type>
        <CreateHexFile>no</CreateHexFile>
        <Preprocessor>no</Preprocessor>
        <Disasm>no</Disasm>
        <CallGraph>no</CallGraph>
        <Map>no</Map>
      </Output>
      <User>
        <BeforeCompile>
          <RunUserProg>no</RunUserProg>
          <UserProgName/>
        </BeforeCompile>
        <BeforeMake>
          <RunUserProg>no</RunUserProg>
          <UserProgName/>
        </BeforeMake>
        <AfterMake>
          <RunUserProg>yes</RunUserProg>
          <UserProgName>cp "$(ProjectPath)/Obj/$(ProjectName).elf" "$(CDKPath)/CSKY/Flash/$(ProjectName).elf"</UserProgName>
        </AfterMake>
      </User>
      <Compiler>
        <Define/>
        <Undefine/>
        <Optim>Optimize (-Og)</Optim>
        <DebugLevel>Default (-g)</DebugLevel>
        <Verbose>no</Verbose>
        <Ansi>no</Ansi>
        <OneElfS>no</OneElfS>
        <Syntax>no</Syntax>
        <Pedantic>no</Pedantic>
        <PedanticErr>no</PedanticErr>
        <InhibitWarn>no</InhibitWarn>
        <AllWarn>yes</AllWarn>
        <WarnErr>no</WarnErr>
        <IncludePath>$(ProjectPath);$(CDKPath)/CSKY/Flash</IncludePath>
        <OtherFlags>-fno-isolate-erroneous-paths-dereference</OtherFlags>
      </Compiler>
      <Asm>
        <Define/>
        <Undefine/>
        <IncludePath>$(ProjectPath)</IncludePath>
        <OtherFlags/>
        <DebugLevel>gdwarf2</DebugLevel>
      </Asm>
      <Linker>
        <Garbage>yes</Garbage>
        <LDFile>$(ProjectPath)/ckcpu.ld</LDFile>
        <LibName/>
        <LibPath/>
        <OtherFlags/>
      </Linker>
      <Debug>
        <Connector>ICE</Connector>
        <LoadApplicationAtStartup>yes</LoadApplicationAtStartup>
        <AutoRun>yes</AutoRun>
        <StopAt>yes</StopAt>
        <StopAtText>main</StopAtText>
        <InitFile>$(ProjectPath)/gdb.init</InitFile>
        <ConfigSIM>
          <SIMTarget/>
          <OtherFlags/>
          <NoGraphic>yes</NoGraphic>
          <Log>no</Log>
        </ConfigSIM>
        <ConfigICE>
          <IP>localhost</IP>
          <PORT>1025</PORT>
          <Clock>12000</Clock>
          <Delay>10</Delay>
          <DDC>yes</DDC>
          <TRST>no</TRST>
          <Connect>Normal</Connect>
          <ResetAfterConnect>yes</ResetAfterConnect>
          <ResetType>soft</ResetType>
          <DownloadToFlash>no</DownloadToFlash>
          <RTOSType>None</RTOSType>
        </ConfigICE>
      </Debug>
      <Flash>
        <InitFile/>
        <Erase>Erase Sectors</Erase>
        <Program>no</Program>
        <Verify>no</Verify>
        <ResetAndRun>no</ResetAndRun>
        <Algorithms/>
      </Flash>
    </BuildConfig>
  </BuildConfigs>
  <VendorInfo>
    <VendorName>NULL</VendorName>
  </VendorInfo>
</Project>
